store.py:
class InventoryManager:
    def __init__(self):
        self.stock = {}

    def restock(self, sku, count):
        self.stock[sku] = count

api.py:
from store import InventoryManager

def handle_restock(payload):
    mgr = InventoryManager()
    mgr.restock(payload["sku"], payload["count"])
    return mgr.stock
