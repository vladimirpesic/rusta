use crate::a::calculate_total;
use crate::a::InvoiceRecord;

pub fn render_invoice(rec: &InvoiceRecord) -> String {
    format!("{} {}", rec.id, calculate_total(&[rec.id]))
}

src/a.rs:
pub fn calculate_total(items: &[u32]) -> u32 {
    items.iter().sum()
}

pub struct InvoiceRecord {
    pub id: u32,
}
