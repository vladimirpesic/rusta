# Rusta reads these from the environment; it does not load this file itself.
# `rusta init` is the easier path — it verifies the key before saving it.
#
# The key is all you need. Leave BASE_URL and MODEL_NAME unset and Rusta picks
# the vendor's recommended model and the endpoint your plan is billed on:
#
#   kimi, Coding Plan (default)  kimi-for-coding  https://api.kimi.com/coding/v1
#   kimi, pay-per-token          kimi-k3.1-pro    https://api.moonshot.ai/v1
#   glm,  Coding Plan (default)  glm-5.3          https://api.z.ai/api/coding/paas/v4
#   glm,  pay-per-token          glm-5.3          https://api.z.ai/api/paas/v4
#   deepseek (pay-as-you-go)     deepseek-flash   https://api.deepseek.com
#
# A Coding Plan key and a pay-per-token key are NOT interchangeable — each is
# rejected by the other's endpoint. Say which one you hold:
#   RUSTA_BILLING=subscription   (default) | api
#   RUSTA_REGION=global          (default) | china
#
# Kimi's Coding Plan has two hosts, and the account decides which one takes the
# key: https://api.kimi.com/coding/v1 (kimi.com accounts) and
# https://api.kimi.ai/coding/v1 (kimi.ai accounts). Unpinned, Rusta tries the
# other host when the first refuses the key; `rusta doctor` names the one
# that works. Its models: kimi-for-coding (K2.8 Preview, 1M, the default),
# kimi-for-coding-highspeed, k3, k3-256k, k3.1-pro and k3.1-pro-highspeed —
# `/model` lists the live set.
#
# The GLM Coding Plan serves glm-5.3 (text) and glm-5.3-flash (images and
# video), both 1M. Older ids are answered by one of those two, and some are
# refused; see docs/providers.md.
#
# DeepSeek is pay-as-you-go only — there is no subscription key, and
# RUSTA_BILLING does not apply. The default model is deepseek-flash
# (V4.1-Flash: 1M context, 384K max output, takes JPEG/PNG/GIF/WebP images),
# which DeepSeek recommends. deepseek-v4-pro, the previous generation, is still
# served and is text-only. `/model` lists the known set.

KIMI_API_KEY=
ZAI_API_KEY=
DEEPSEEK_API_KEY=

# Optional overrides. Only set these to pin a specific model or endpoint.
# KIMI_MODEL_NAME=
# KIMI_BASE_URL=
# ZAI_MODEL_NAME=
# ZAI_BASE_URL=
# DEEPSEEK_MODEL_NAME=   # deepseek-flash (default) | deepseek-v4-pro
# DEEPSEEK_BASE_URL=

# Optional tuning; docs/configuration.md lists every variable and config key.
# RUSTA_INFINITE_RETRY=1            # retry failing model calls without limit
# RUSTA_TOOL_OUTPUT_MAX_CHARS=50000 # per tool result; 0 disables the cap
# RUSTA_READ_MAX_CHARS=500000       # ceiling on read_file's max_chars; 0 removes it
# RUSTA_COMPACTION_MAX_ATTEMPTS=5   # model requests per context compaction
# RUSTA_IMAGE_READ_BYTE_BUDGET=262144 # bytes per image sent to the model; 0 = none
# RUSTA_INLINE_VIDEO=1              # video for --provider openai vision models
# Z_AI_VISION_MCP_URL=              # remote Z.AI vision MCP server instead of npx
# RUSTA_REPEAT_BREAKER=0            # no repeat reminders or forced stops
# RUSTA_DANGEROUS_COMMAND_GUARD=0   # never ask before rm -rf, shutdown, ...
# RUSTA_TRUST_WORKSPACE=1           # apply .rusta.toml MCP servers, keys, ... for one run
# RUSTA_SWARM_TIMEOUT_MS=7200000    # per agent_swarm member; 0 = none
# RUSTA_SWARM_MAX_CONCURRENCY=3     # agent_swarm members at once; unset = all
# RUSTA_HEADLESS_BACKGROUND_MODE=steer  # -p after the prompt: steer | drain | exit
# RUSTA_HEADLESS_WAIT_CEILING_S=3600    # -p: longest wait/steer after the prompt
# RUSTA_HEADLESS_MAX_TURNS=20           # -p: follow-up turn cap (steer)
# Extra headers on model requests, one "Name: value" per line:
# RUSTA_CUSTOM_HEADERS="X-Gateway-Route: coding"
